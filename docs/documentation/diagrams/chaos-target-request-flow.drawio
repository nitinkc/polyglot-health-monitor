<mxfile host="Electron">
  <diagram id="request-flow" name="Request-Flow">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="req" value="&lt;b&gt;Poll request arrives&lt;/b&gt;&lt;br&gt;GET /health · /jitter · /slow · /hang&lt;br&gt;/error/N · /reset · /eof · /malformed · /flap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="paused" value="instance paused?&lt;br&gt;(/chaos/pause)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="600" y="160" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="block" value="frozen:&lt;br&gt;block until pause expires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="170" width="140" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mode" value="instance&lt;br&gt;&lt;b&gt;MODE&lt;/b&gt;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ctl" value="&lt;b&gt;POST /chaos/mode · /pause · /crash&lt;/b&gt;&lt;br&gt;changes mode live — never gated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="170" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="mHealthy" value="&lt;b&gt;healthy&lt;/b&gt;&lt;br&gt;pass straight through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mJitter" value="&lt;b&gt;jitter&lt;/b&gt;&lt;br&gt;sleep ~15ms&lt;br&gt;10% spike → up to 800ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mDegraded" value="&lt;b&gt;degraded&lt;/b&gt;&lt;br&gt;+0–400ms;&lt;br&gt;rand &amp;lt; error_rate → 5xx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mSlow" value="&lt;b&gt;slow&lt;/b&gt;&lt;br&gt;hold SLOW_MS&lt;br&gt;then continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="580" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mFlap" value="&lt;b&gt;flapping&lt;/b&gt;&lt;br&gt;in fail window → 503&lt;br&gt;in ok window → pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mReset" value="&lt;b&gt;reset&lt;/b&gt;&lt;br&gt;hijack conn → TCP RST&lt;br&gt;(ECONNRESET)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="940" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="mDown" value="&lt;b&gt;down&lt;/b&gt;&lt;br&gt;instant 503&lt;br&gt;readyz also fails" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="420" width="140" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="handler" value="&lt;b&gt;route handler runs&lt;/b&gt;&lt;br&gt;the endpoint's own behavior&lt;br&gt;(jitter · hold · flap window · fixed error…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="560" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="faultFast" value="&lt;b&gt;immediate fault&lt;/b&gt;&lt;br&gt;route logic never runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="560" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ok200" value="&lt;b&gt;200 OK + JSON&lt;/b&gt;&lt;br&gt;instance · region · seq&lt;br&gt;latency_ms · X-* headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="700" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="codedErr" value="&lt;b&gt;coded HTTP error&lt;/b&gt;&lt;br&gt;429 + Retry-After&lt;br&gt;500 / 502 / 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="700" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="transport" value="&lt;b&gt;transport fault&lt;/b&gt;&lt;br&gt;RST · mid-stream EOF&lt;br&gt;garbage bytes · silent hang" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="700" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="record" value="&lt;b&gt;monitor records check_result&lt;/b&gt;&lt;br&gt;success · status_code · latency_ms · error&lt;br&gt;→ consecutive_failures → UP / DOWN transitions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="820" width="280" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="req" target="paused" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="paused" target="block" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="block" target="mode" value="resumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="paused" target="mode" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="m0" edge="1" parent="1" source="mode" target="mHealthy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" edge="1" parent="1" source="mode" target="mJitter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" edge="1" parent="1" source="mode" target="mDegraded" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" edge="1" parent="1" source="mode" target="mSlow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" edge="1" parent="1" source="mode" target="mFlap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" edge="1" parent="1" source="mode" target="mReset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" edge="1" parent="1" source="mode" target="mDown" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="h1" edge="1" parent="1" source="mHealthy" target="handler" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h2" edge="1" parent="1" source="mJitter" target="handler" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h3" edge="1" parent="1" source="mDegraded" target="handler" value="~50% pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h4" edge="1" parent="1" source="mSlow" target="handler" value="pass (late)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h5" edge="1" parent="1" source="mFlap" target="handler" value="ok window" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="mDegraded" target="faultFast" value="rand&amp;lt;rate → 5xx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="mFlap" target="faultFast" value="fail window → 503" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f3" edge="1" parent="1" source="mReset" target="faultFast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="f4" edge="1" parent="1" source="mDown" target="faultFast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="o1" edge="1" parent="1" source="handler" target="ok200" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="o2" edge="1" parent="1" source="handler" target="codedErr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="o3" edge="1" parent="1" source="handler" target="transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="o4" edge="1" parent="1" source="faultFast" target="codedErr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="o5" edge="1" parent="1" source="faultFast" target="transport" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="r1" edge="1" parent="1" source="ok200" target="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r2" edge="1" parent="1" source="codedErr" target="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="r3" edge="1" parent="1" source="transport" target="record" value="status_code=null" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="c1" edge="1" parent="1" source="ctl" target="mode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#9673a6;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
